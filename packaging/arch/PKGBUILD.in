# Local Arch/Manjaro package; generated by scripts/package.py.
# Maintainer: Local LinFXP project
pkgname=linfxp
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Native GUI for local, SFTP, and direct server-to-server file transfers'
url='@PROJECT_URL@'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'libssh>=0.11' 'libsecret' 'glib2' 'libgcc_s.so' 'libstdc++.so' 'glibc')
makedepends=('cmake' 'ninja' 'pkgconf')
checkdepends=('python' 'python-paramiko')
optdepends=('gnome-keyring: saved passwords via the desktop Secret Service')
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=ON
    cmake --build "$srcdir/build" --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
    "$srcdir/build/linfxp" --version
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
